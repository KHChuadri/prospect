DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jobtracker
# --- LLM provider (OpenAI-compatible). Set LLM_* to use any provider. ---
# If LLM_* are unset, the OPENROUTER_* values below are used as a fallback.
# OpenRouter (free tier is flaky / rate-limited):
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-...
LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Groq (free tier, fast + reliable) — swap the three lines above for:
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_API_KEY=gsk_...
#   LLM_MODEL=llama-3.3-70b-versatile
# Google Gemini (free tier):
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   LLM_API_KEY=AIza...
#   LLM_MODEL=gemini-2.0-flash

# Legacy fallback (used only if LLM_* are unset):
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=anthropic/claude-haiku-4.5
JWT_SIGNING_KEY=dev-only-secret-change-in-production-min-32-chars
JWT_ISSUER=JobApplicationTracker
JWT_AUDIENCE=JobApplicationTrackerUsers
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM=you@gmail.com
FOLLOWUP_AGE_DAYS=7
CLIENT_ORIGIN=http://localhost:3000
# Gmail → recommendations (v1). Mint the refresh token with gmail_authorize.py.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_LABEL=job-alerts
RECO_USER_ID=1
RECO_POLL_MINUTES=15
